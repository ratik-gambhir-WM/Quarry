.DS_Store

# Local Zed editor and debugger configuration.
/.zed/

# One live local environment file per runtime. Ignore Vite/dotenv variants too so
# an accidental alternate file cannot expose secrets through version control.
backend/.env
backend/.env.*
backend/.helix/
backend/data/
backend/target/

frontend/.env
frontend/.env.*
frontend/dist/
frontend/node_modules/
frontend/src-tauri/gen/schemas/
frontend/src-tauri/target/

*.log
