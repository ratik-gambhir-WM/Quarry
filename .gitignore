.DS_Store

# One live local environment file per runtime. Ignore Vite/dotenv variants too so
# an accidental alternate file cannot expose secrets through version control.
backend/.env
backend/.env.*
backend/.helix/
backend/data/
backend/target/

diligence-studio-server/.env
diligence-studio-server/.env.*
diligence-studio-server/coverage/
diligence-studio-server/data/
diligence-studio-server/node_modules/
diligence-studio-server/server-dist/
diligence-studio-server/.vite/
diligence-studio-server/.vitest/
diligence-studio-server/*.tsbuildinfo

frontend/.env
frontend/.env.*
frontend/dist/
frontend/node_modules/
frontend/src-tauri/gen/schemas/
frontend/src-tauri/target/

*.log
