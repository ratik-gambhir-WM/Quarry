{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@ericts": "https://ui.ericts.com/r/{name}.json",
    "@ilinxa": "https://ui.ilinxa.com/r/{name}.json",
    "@heroicons-animated": "https://www.heroicons-animated.com/r/{name}.json",
    "@shark": "https://shark.vini.one/r/{name}.json"
  }
}
